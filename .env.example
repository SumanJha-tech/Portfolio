# Public URL where the site is deployed (used for canonical + Open Graph tags).
VITE_SITE_URL=https://sumanjha-tech.github.io/portfolio

# Optional: contact-form endpoint. Default sends to sumanjha0906@gmail.com via FormSubmit.
# To use Formspree instead, create a form there and paste its URL:
# VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Recommended for reliable contact-form delivery (free, no activation click):
# 1) Go to https://web3forms.com, enter sumanjha0906@gmail.com, copy the access key from the email.
# 2) Paste it here (and in Vercel Environment Variables):
# VITE_WEB3FORMS_KEY=your-access-key
